{
  "schema_version": "treecalc-corpus-v1",
  "theme": "references/escaping-raw-active",
  "workset": "W004",
  "status": "active",
  "status_note": "Focused active resolution subset for bracket-escaped host paths through direct OxCalcTreeContext. The broader references/escaping syntax corpus remains pending for full parser/profile/canonical display coverage.",
  "description": "Bracket-escaped node names and escaped reserved characters where OxFml emits escaped-path host-reference packets and OxCalc decodes path segments while resolving against the canonical tree context.",
  "cases": [
    {
      "id": "active-esc-space",
      "name": "a name with a space is bracket-escaped",
      "spec": "§3.4",
      "kind": "resolution",
      "workspace": "escaping-active",
      "caller": "Escapes.Caller",
      "reference": "[Sales Q1]",
      "profile": "treecalc-v1",
      "expect": {
        "outcome": "resolved",
        "target": "Escapes.Sales Q1",
        "published_value": "5",
        "decodes_to": "Sales Q1"
      }
    },
    {
