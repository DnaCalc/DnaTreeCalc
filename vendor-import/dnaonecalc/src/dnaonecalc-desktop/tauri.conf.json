{
  "$schema": "https://raw.githubusercontent.com/nicxlabs/tauri-v2/refs/tags/tauri-v2.3.1/crates/tauri-cli/schema.json",
  "productName": "DNA OneCalc",
  "version": "0.1.0",
  "identifier": "com.dnakode.onecalc",
  "build": {
    "beforeDevCommand": "pwsh -File ..\\..\\scripts\\run-onecalc-preview.ps1 -BuildOnly",
    "beforeBuildCommand": "pwsh -File ..\\..\\scripts\\run-onecalc-preview.ps1 -BuildOnly",
    "frontendDist": "../../target/onecalc-preview"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DNA OneCalc",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
